{
    "name": "cms-provenance/provenance-facts",
    "type": "typo3-cms-extension",
    "description": "Addressable facts within content, exposed as Microdata and W3C Web Annotations.",
    "license": "GPL-2.0-or-later",
    "homepage": "https://cms-provenance.org",
    "keywords": [
        "TYPO3",
        "extension",
        "provenance",
        "content-provenance",
        "json-ld"
    ],
    "support": {
        "issues": "https://github.com/dkd-dobberkau/typo3-provenance-facts/issues",
        "source": "https://github.com/dkd-dobberkau/typo3-provenance-facts"
    },
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^13.4 || ^14.0",
        "cms-provenance/provenance": "^0.1@dev"
    },
    "autoload": {
        "psr-4": {
            "CmsProvenance\\ProvenanceFacts\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "provenance_facts"
        }
    }
}
